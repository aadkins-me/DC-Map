{
  "name": "dc-neighborhood-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "fetch-data": "node scripts/fetch-data.mjs",
    "zip": "npm run build && rm -f release/dc-map-site.zip && mkdir -p release && cd dist && zip -qr ../release/dc-map-site.zip .",
    "dev:netlify": "npx --yes netlify-cli@latest dev",
    "test": "node --test --experimental-strip-types netlify/lib/board.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.4",
    "maplibre-gl": "^6.14.0"
  }
}
